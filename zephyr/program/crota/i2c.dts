 #include <dt-bindings/usb_pd_tcpm.h>

/ {
	named-i2c-ports {
		compatible = "named-i2c-ports";
		i2c_sensor: sensor {
			i2c-port = <&i2c0_0>;
			enum-names = "I2C_PORT_SENSOR";
		};
		tcpc0_2: tcpc0_2 {
			i2c-port = <&i2c1_0>;
			enum-names = "I2C_PORT_USB_C0_C1_TCPC";
		};
		c0_c2_bc12: c0_c2_bc12 {
			i2c-port = <&i2c2_0>;
			enum-names = "I2C_PORT_USB_C0_C1_PPC",
				"I2C_PORT_USB_C0_C1_BC12";
		};
		retimer0_2: retimer0_2 {
			i2c-port = <&i2c3_0>;
			enum-names = "I2C_PORT_USB_C0_C1_MUX";
		};
		battery {
			i2c-port = <&i2c5_0>;
			enum-names = "I2C_PORT_BATTERY";
		};
		i2c_charger: charger {
			i2c-port = <&i2c7_0>;
			enum-names =  "I2C_PORT_CHARGER",
				"I2C_PORT_EEPROM",
				"I2C_PORT_MP2964";
		};
	};
};

&i2c0_0 {
	status = "okay";
	label = "I2C_SENSOR";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_0_sda_scl_gpb4_b5>;
	pinctrl-names = "default";
};

&i2c_ctrl0 {
	status = "okay";
};

&i2c1_0 {
	status = "okay";
	label = "I2C_TCPC";
	clock-frequency = <I2C_BITRATE_FAST_PLUS>;
	pinctrl-0 = <&i2c1_0_sda_scl_gp87_90>;
	pinctrl-names = "default";

	tcpc_port0: nct38xx@70 {
		compatible = "nuvoton,nct38xx";
		reg = <0x70>;
		gpio-dev = <&nct3808_0_P1>;
		tcpc-flags = <(
			TCPC_FLAGS_TCPCI_REV2_0 |
			TCPC_FLAGS_NO_DEBUG_ACC_CONTROL)>;
		/* a duplicate of the <&gpio_usb_c0_c2_tcpc_int_odl> node in
		 * "named-gpios". This is the Zephyr preferred style,
		 * the "named-gpios" node will be dealt with at a later date.
		 */
		irq-gpios = <&gpioe 0 GPIO_ACTIVE_LOW>;
	};

	nct3808_0_P1: nct3808_0_P1@70 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "nuvoton,nct38xx-gpio";
		reg = <0x70>;
		label = "NCT3808_0_P1";

		ioex_port1: gpio@0 {
			compatible = "nuvoton,nct38xx-gpio-port";
			reg = <0x0>;
			label = "NCT3808_0_P1_GPIO0";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <8>;
			pin_mask = <0xdc>;
			pinmux_mask = <0xff>;
		};
	};

	tcpc_port1: nct38xx@73 {
		compatible = "nuvoton,nct38xx";
		reg = <0x73>;
		gpio-dev = <&nct3808_0_P2>;
		tcpc-flags = <(TCPC_FLAGS_TCPCI_REV2_0)>;
		/* a duplicate of the <&gpio_usb_c0_c2_tcpc_int_odl> node in
		 * "named-gpios". This is the Zephyr preferred style,
		 * the "named-gpios" node will be dealt with at a later date.
		 */
		irq-gpios = <&gpioe 0 GPIO_ACTIVE_LOW>;
	};

	nct3808_0_P2: nct3808_0_P2@73 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "nuvoton,nct38xx-gpio";
		reg = <0x73>;
		label = "NCT3808_0_P2";

		ioex_port2: gpio@0 {
			compatible = "nuvoton,nct38xx-gpio-port";
			reg = <0x0>;
			label = "NCT3808_0_P2_GPIO0";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <8>;
			pin_mask = <0xdc>;
			pinmux_mask = <0xff>;
		};
	};

	nct3808_alert_1 {
		compatible = "nuvoton,nct38xx-gpio-alert";
		/* a duplicate of the <&gpio_usb_c0_c2_tcpc_int_odl> node in
		 * "named-gpios". This is the Zephyr preferred style,
		 * the "named-gpios" node will be dealt with at a later date.
		 */
		irq-gpios = <&gpioe 0 GPIO_ACTIVE_LOW>;
		nct38xx-dev = <&nct3808_0_P1 &nct3808_0_P2>;
		label = "NCT3808_ALERT_1";
	};
};

&i2c_ctrl1 {
	status = "okay";
};

&i2c2_0 {
	status = "okay";
	label = "I2C_PPC_BC12";
	clock-frequency = <I2C_BITRATE_FAST_PLUS>;
	pinctrl-0 = <&i2c2_0_sda_scl_gp91_92>;
	pinctrl-names = "default";

	ppc_port0: syv682x@40 {
		compatible = "silergy,syv682x";
		status = "okay";
		reg = <0x40>;
		frs_en_gpio = <&usb_c0_frs_en>;
	};

	bc12_port0: pi3usb9201@5f {
		compatible = "pericom,pi3usb9201";
		status = "okay";
		reg = <0x5f>;
		irq = <&int_usb_c0_bc12>;
	};

	ppc_port1: syv682x@42 {
		compatible = "silergy,syv682x";
		status = "okay";
		reg = <0x42>;
		frs_en_gpio = <&usb_c1_frs_en>;
	};

	bc12_port1: pi3usb9201@5d {
		compatible = "pericom,pi3usb9201";
		status = "okay";
		reg = <0x5d>;
		irq = <&int_usb_c1_bc12>;
	};
};

&i2c_ctrl2 {
	status = "okay";
};

&i2c3_0 {
	status = "okay";
	label = "I2C_BB";
	clock-frequency = <I2C_BITRATE_FAST_PLUS>;
	pinctrl-0 = <&i2c3_0_sda_scl_gpd0_d1>;
	pinctrl-names = "default";

	usb_c0_bb_retimer: jhl8040r-c0@58 {
		compatible = "intel,jhl8040r";
		reg = <0x58>;
		int-pin = <&usb_c0_rt_int_odl>;
		reset-pin = <&usb_c0_rt_rst_odl>;
	};

	usb_c1_soc_side_bb_retimer: jhl8040r-c1-soc-side@54 {
		compatible = "intel,jhl8040r";
		reg = <0x54>;
		int-pin = <&usb_c1_rt_int_odl>;
		reset-pin = <&usb_c1_rt_rst_odl>;
	};

	usb_c1_bb_retimer: jhl8040r-c1@57 {
		compatible = "intel,jhl8040r";
		reg = <0x57>;
		int-pin = <&usb_c1_rt_int_odl>;
		reset-pin = <&usb_c1_rt_rst_odl>;
	};
};

&i2c_ctrl3 {
	status = "okay";
};

&i2c_ctrl4 {
	status = "okay";
};

&i2c5_0 {
	status = "okay";
	label = "I2C_BATTERY";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c5_0_sda_scl_gp33_36>;
	pinctrl-names = "default";
};

&i2c_ctrl5 {
	status = "okay";
};

&i2c_ctrl6 {
	status = "okay";
};

&i2c7_0 {
	status = "okay";
	label = "I2C_CHARGER";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c7_0_sda_scl_gpb2_b3>;
	pinctrl-names = "default";

	pmic_mp2964@20 {
		compatible = "mps,mp2964";
		reg = <0x20>;
	};

	charger: bq25710@9 {
		compatible = "ti,bq25710";
		status = "okay";
		reg = <0x9>;
	};

	cbi_eeprom: eeprom@50 {
		compatible = "atmel,at24";
		reg = <0x50>;
		size = <2048>;
		pagesize = <16>;
		address-width = <8>;
		timeout = <5>;
	};
};

&i2c_ctrl7 {
	status = "okay";
};
