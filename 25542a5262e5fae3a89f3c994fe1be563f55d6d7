      },
      "writtenOn": "2020-12-23T22:11:00Z",
      "side": 1,
      "message": "The cable is expected to send an Accept following the GoodCRC. The spec explicitly calls out checking setting SenderResponseTimer from this state.",
      "parentUuid": "5ff0f8f7_7dc1086d",
      "revId": "25542a5262e5fae3a89f3c994fe1be563f55d6d7",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
